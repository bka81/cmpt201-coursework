#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <errno.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(void) {  
    char* buffer = NULL;
    size_t size = 0;
    ssize_t read = -1;  
    
    size_t numStrings = 5;
    char** store = (char**)malloc(sizeof(char*) * (numStrings + 1));
    int i = 0; //index
               
    while (1) {
      printf("Enter input.\n");
      read = getline(&buffer, &size, stdin);
      if (read == -1) {
        perror("getline failed");
        free(buffer);
        exit(EXIT_FAILURE);
      }
      store[i] = buffer;
      i++;
      if(strcmp(buffer, "print")) {
        for(int j = 0; j < numStrings; j++) {
        printf("%s\n", store[j]);
        }
      } 
    }
  }
