#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(void) {
  char *buffer = NULL;
  size_t size = 0;
  ssize_t read = -1;

  size_t numStrings = 5;
  char **store = (char **)malloc(sizeof(char *) * (numStrings + 1));
  for (size_t k = 0; k < numStrings; k++) {
    store[k] = (char *)malloc(100 * sizeof(char));
  }
  int i = 0; // index

  while (1) {
    printf("Enter input.\n");
    read = getline(&store[i], &size, stdin);
    if (read == -1) {
      perror("getline failed");
      free(buffer);
      exit(EXIT_FAILURE);
    }
    //store[i] = buffer;
    i = (i + 1) % numStrings;
    printf("index %d, string: %s/n", i, store[i]);
    // if (strcmp(store[i], "print")) {
    // printf("User typed print");
    /*for (int j = 0; j < numStrings; j++) {
       printf("%s\n", store[(i + 1 + j) % numStrings]);
     }*/
    //}
  }
}
