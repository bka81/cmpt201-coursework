#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(void) {
  size_t size = 0;
  ssize_t read = -1;
  char *ptrToNext = NULL;

  size_t numStrings = 5;
  char **store = (char **)malloc(sizeof(char *) * (numStrings + 1));

  int i = 0; // index

  while (1) {
    printf("Enter input: \n");
    read = getline(&store[i], &size, stdin);
    if (read == -1) {
      perror("getline failed");
      free(store[i]);
      exit(EXIT_FAILURE);
    }

    if (strcmp(store[i], "print\n") == 0) {
      for (int j = 0; j < numStrings; j++) {
        char *toPrint = store[(i + 1 + j) % numStrings];
        if (toPrint != NULL) {
          printf("%s", toPrint);
        }
      }
    }
    i = (i + 1) % numStrings;
  }
}
