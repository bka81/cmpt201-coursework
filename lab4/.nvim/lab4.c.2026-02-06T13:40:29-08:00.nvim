#define _XOPEN_SOURCE 500
#include <stdint.h>
#include <stdio.h>
#include <unistd.h>
// #include <stdint.h>
// #include <stdio.h>
// #include <stdlib.h>
int BUF_SIZE = 50;
struct block {
  uint64_t size;
  struct block *next;
};

void print_out(char *format, void *data, size_t data_size) {
  char buf[BUFSIZ];
  ssize_t len = snprintf(buf, BUFSIZ, format,
                         data_size == sizeof(uint64_t) ? *(uint64_t *)data
                                                       : *(void **)data);
  if (len < 0) {
    perror("snprintf");
  }
  write(STDOUT_FILENO, buf, len);
}

int main(void) {
  void *program_break;
  program_break = sbrk(0);
  void *allocated_mem_addr = sbrk(256);
  print_out("program break address: %p\n", &program_break,
            sizeof(&program_break));

  print_out("allocated mem address: %p\n", &allocated_mem_addr,
            sizeof(&allocated_mem_addr));
  
  struct block *block1 = (struct block *)allocated_mem_addr;

  print_out("allocated mem address: %p\n", &block1, sizeof(&block1));



  return 0;
}
