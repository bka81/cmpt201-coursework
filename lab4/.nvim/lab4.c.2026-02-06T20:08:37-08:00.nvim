#define _XOPEN_SOURCE 500
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
// #include <stdint.h>
// #include <stdio.h>
// #include <stdlib.h>
int BUF_SIZE = 50;
struct block {
  uint64_t size;
  struct block *next;
};

void print_out(char *format, void *data, size_t data_size) {
  char buf[BUFSIZ];
  ssize_t len = snprintf(buf, BUFSIZ, format,
                         data_size == sizeof(uint64_t) ? *(uint64_t *)data
                                                       : *(void **)data);
  if (len < 0) {
    perror("snprintf");
  }
  write(STDOUT_FILENO, buf, len);
}

int main(void) {
  void *program_break;
  program_break = sbrk(0);
  void *allocated_mem_addr = sbrk(256);
  void *addr_second_block = allocated_mem_addr + 128;
  print_out("program break address: %p\n", &program_break,
            sizeof(&program_break));

  print_out("allocated mem address: %p\n", &allocated_mem_addr,
            sizeof(&allocated_mem_addr));

  struct block *block1 = (struct block *)allocated_mem_addr;
  struct block *block2 = (struct block *)addr_second_block;
  print_out("allocated mem address: %p\n", &block1, sizeof(&block1));
  print_out("allocated second block address: %p\n", &block2, sizeof(&block2));
  block1->size = 128;
  block1->next = NULL;
  block2->size = 128;
  block2->next = block1;

  print_out("testing: first block size: %d\n", &block1->size, sizeof(&block1->size));

  void *initialized_block1 = memset(block1, 0, 128);

  

  return 0;
}
